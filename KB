    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Noto Sans KR', '-apple-system', 'BlinkMacSystemFont', 'sans-serif']
                    },
                    colors: {
                        kbYellow: '#FFBC00',
                        kbYellowDark: '#E5A800',
                        kbGold: '#B8860B',
                        kbGrayBg: '#F4F5F7',
                        kbCardBg: '#FFFFFF',
                        kbTextMain: '#191919',
                        kbTextSub: '#666666',

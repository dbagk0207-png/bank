    <!-- Interactive JavaScript Logic -->
    <script>
        let isBalanceVisible = true;
        const actualBalance = '1,234,567원';
        const maskedBalance = '***원';
        let pinInput = '';

        // Toggle balance display logic
        function toggleBalanceState() {
            isBalanceVisible = !isBalanceVisible;
            const balanceEl = document.getElementById('accountBalanceDisplay');
            const toggleCircle = document.getElementById('toggleCircle');
            const toggleBtn = document.getElementById('toggleBtn');

            if (isBalanceVisible) {
                balanceEl.textContent = actualBalance;
                toggleCircle.classList.add('translate-x-4');
                toggleBtn.classList.replace('bg-gray-300', 'bg-[#A1887F]');
            } else {
                balanceEl.textContent = maskedBalance;
                toggleCircle.classList.remove('translate-x-4');
                toggleBtn.classList.replace('bg-[#A1887F]', 'bg-gray-300');
            }
        }

        // Show toast banner
        function showToast(msg) {
            const toast = document.getElementById('toast');
            toast.textContent = msg;
            toast.classList.remove('opacity-0', 'pointer-events-none');
            toast.classList.add('opacity-100');
            setTimeout(() => {
                toast.classList.remove('opacity-100');
                toast.classList.add('opacity-0', 'pointer-events-none');
            }, 1800);
        }

        // Modal triggers
        function openModal(id) {
            const modal = document.getElementById(id);
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }

        function closeModal(id) {
            const modal = document.getElementById(id);
            modal.classList.add('hidden');
            modal.classList.remove('flex');
            if (id === 'pinModal') clearPin();
        }

        // Keypad logic for PIN authentication
        function pressKey(num) {
            if (pinInput.length < 4) {
                pinInput += num;
                updateDots();
                if (pinInput.length === 4) {
                    setTimeout(() => {
                        closeModal('pinModal');
                        openModal('accountDetailModal');
                        showToast('인증이 완료되었습니다.');
                    }, 150);
                }
            }
        }

        function deleteKey() {
            if (pinInput.length > 0) {
                pinInput = pinInput.slice(0, -1);
                updateDots();
            }
        }

        function clearPin() {
            pinInput = '';
            updateDots();
        }

        function updateDots() {
            const dots = document.querySelectorAll('.pin-dot');
            dots.forEach((dot, idx) => {
                if (idx < pinInput.length) {
                    dot.classList.add('bg-[#FFBC00]', 'border-[#FFBC00]');
                    dot.classList.remove('border-gray-300');
                } else {
                    dot.classList.remove('bg-[#FFBC00]', 'border-[#FFBC00]');
                    dot.classList.add('border-gray-300');
                }
            });
        }

        // Refresh stock simulator
        function refreshStockData() {
            const icon = document.getElementById('stockRefreshIcon');
            icon.classList.add('fa-spin');
            setTimeout(() => {
                icon.classList.remove('fa-spin');
                showToast('증시 정보가 업데이트되었습니다.');
            }, 600);
        }

        // Navigation Tab Selection Visual Change
        function selectTab(buttonEl) {
            const navTabs = document.querySelectorAll('nav button');
            navTabs.forEach(btn => {
                btn.classList.remove('text-black');
                btn.classList.add('text-gray-600');
            });
            buttonEl.classList.remove('text-gray-600');
            buttonEl.classList.add('text-black');
        }
    </script>
</body>
</html>

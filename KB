        /* Custom toggle switch style matching exact KB toggle */
        .toggle-checkbox:checked {
            right: 0;
            border-color: #795548;
        }
        .toggle-checkbox:checked + .toggle-label {
            background-color: #8D6E63;
        }

        /* Yellow highlight text effect */
